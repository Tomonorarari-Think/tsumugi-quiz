{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsumugi-quiz.local/schemas/question-set.schema.json",
  "title": "TsumugiQuiz Question Set",
  "description": "tsumugi-quiz の問題セットファイル。docs/question-data.md 参照。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "setId", "title", "questions"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "スキーマバージョン。現行は 1 固定。"
    },
    "setId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "問題セットの一意な識別子。ファイル名とは独立。"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "問題セットの表示名。"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "問題セットの説明（任意）。"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" },
      "description": "問題の配列。id はセット内で一意でなければならない（配列内での重複はバリデーションエラー）。"
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "type", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "セット内で一意な問題 ID。"
        },
        "type": {
          "type": "string",
          "enum": ["freeText", "choice"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "画面表示用の問題文。"
        },
        "readingText": {
          "type": "string",
          "maxLength": 500,
          "description": "読み上げ用テキスト。省略時は text を読み上げる。"
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "freeText 用の正解候補（いずれか一致で正解）。上限20件はQuestionLimits.MaxAnswerCount（issue #32）。"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "choice 用の選択肢。"
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "choice 用。正解の choices 配列インデックス（0 始まり）。"
        },
        "imagePath": {
          "type": "string",
          "minLength": 1,
          "description": "問題セットファイルからの相対パス（例: images/q1.png）。省略可。"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "freeText" } },
            "required": ["type"]
          },
          "then": {
            "required": ["answers"],
            "not": { "required": ["choices", "correctIndex"] }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "choice" } },
            "required": ["type"]
          },
          "then": {
            "required": ["choices", "correctIndex"],
            "not": { "required": ["answers"] }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
